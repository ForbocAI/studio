{
  "routes": {
    "root": "/",
    "npcProcess": "api/chat",
    "npcMemory": "api/memory"
  },
  "serverExternalPackages": [
    "@forbocai/node",
    "@lancedb/lancedb"
  ],
  "memory": {
    "namespace": "studio-npc",
    "separator": "-",
    "queryParameter": "npcId",
    "pageLimit": 100,
    "pageOffset": 0
  },
  "cacheTags": {
    "memory": "Memory"
  },
  "http": {
    "methods": {
      "post": "POST",
      "get": "GET"
    },
    "status": {
      "ok": 200,
      "badRequest": 400,
      "unauthorized": 401,
      "badGateway": 502
    }
  },
  "messages": {
    "invalidRequest": "NPC request must include an identifier, observation, structured persona, and context",
    "invalidMemoryRequest": "NPC memory request must include an identifier",
    "invalidResponse": "ForbocAI NPC did not produce a valid result",
    "processingFailed": "ForbocAI NPC processing failed"
  }
}
