{
  "routes": {
    "account": "https://account.forboc.ai/"
  },
  "cookie": {
    "name": "forboc_session"
  },
  "jwt": {
    "secretEnvironment": "JWT_SECRET",
    "algorithm": "HS256"
  },
  "messages": {
    "missingSecretSuffix": " is not set",
    "unauthorized": "Authentication is required"
  },
  "navigationMatcher": "/((?!api|_next/static|_next/image|favicon.ico|logo.png|.*\\.svg$).*)"
}
